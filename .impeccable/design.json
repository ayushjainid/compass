  "narrative": {
    "northStar": "The Field Notebook",
    "keyCharacteristics": [
      "Cool paper background, white leaves, near-black green-tinted ink.",
      "Serif (Newsreader) for headings and dates; IBM Plex Sans for everything you read and tap; Plex Mono only for small counts.",
      "One navy action per screen; brass for focus; moss for done; amber for care.",
      "Rounded, tactile controls with a small press response; bottom sheets for detail.",
      "Calm by default: no streaks, no red, no nagging badges."
    ],
    "rules": [
      {
        "name": "The One Navy Rule",
        "body": "A screen has at most one filled navy button. Everything else is a secondary, quiet or chip control.",
        "section": "colors"
      },
      {
        "name": "The No Red Rule",
        "body": "Compass never uses red for a person's own progress. Missed and overdue are amber; failure is not a state the app shows.",
        "section": "colors"
      },
      {
        "name": "The Serif Speaks, The Sans Works Rule",
        "body": "Serif is for names, dates and headings only; never for buttons, inputs or body copy.",
        "section": "typography"
      },
      {
        "name": "The Leaf Rule",
        "body": "Resting surfaces are lifted only as far as paper on a desk. Anything that floats higher must be temporary (a sheet, a toast) or the one persistent action (the add button).",
        "section": "elevation"
      }
    ]
  }
